# Adapter: vtuber (Alba VTuber con VTube Studio), pngtuber (Alba PNGTuber) o fake
# Las formas antiguas vts y pet se aceptan como alias.
ALBA_ADAPTER=vtuber

# Solicitar permiso de imagenes en VTS al arrancar (opcional; muestra un popup)
VTS_REQUEST_ITEM_PERMISSION=false

# Puerto de la Plugin API de VTube Studio
VTS_PORT=8001

# Token de plugin (se rellena al aprobar el popup de VTS)
VTS_AUTH_TOKEN=

# Puerto del bridge (solo loopback)
ALBA_BRIDGE_PORT=8790

# Token que los clientes envian en X-Alba-Token
ALBA_TOKEN=

# Control de procesos opt-in; nunca se ejecuta sin confirmacion por operacion
VTS_PROCESS_CONTROL=false
# Arrays JSON de ejecutable + argumentos (sin shell); usa comillas simples en dotenv
VTS_CLOSE_COMMAND=
# Launcher que regresa al abrir VTS (p. ej. un launcher local configurado por el usuario)
VTS_LAUNCH_COMMAND=
