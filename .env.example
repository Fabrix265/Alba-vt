# Adapter: vts (real) o fake (sin VTube Studio)
ALBA_ADAPTER=vts

# Solicitar permiso de imagenes en VTS al arrancar (opcional; muestra un popup)
VTS_REQUEST_ITEM_PERMISSION=false

# Puerto de la Plugin API de VTube Studio
VTS_PORT=8001

# Token de plugin (se rellena al aprobar el popup de VTS)
VTS_AUTH_TOKEN=

# Puerto del bridge (solo loopback)
ALBA_BRIDGE_PORT=8790

# Token que los clientes envian en X-Alba-Token
ALBA_TOKEN=

# Como reabrir VTube Studio al despertar de deep_sleep (opcional)
VTS_LAUNCH_COMMAND=
