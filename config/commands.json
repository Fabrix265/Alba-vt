{
  "$schema": "./schemas/commands.schema.json",
  "commands": {
    "good night": {
      "intent": "sleep",
      "description": "Alba se duerme y deja de reaccionar"
    },
    "ring ring": {
      "intent": "wake",
      "description": "Despierta a Alba"
    },
    "lights out": {
      "intent": "deep_sleep",
      "confirm": true,
      "description": "Cierra VTube Studio (pide confirmacion)"
    },
    "hello": {
      "intent": "celebrate",
      "description": "Saludo suave"
    },
    "focus": {
      "intent": "coding",
      "args": { "props": ["keyboard"] },
      "description": "Modo programar con teclado"
    },
    "tea time": {
      "intent": "idle",
      "args": { "props": ["mug"] },
      "description": "Descanso con taza"
    },
    "oops": {
      "intent": "error",
      "description": "Reaccion de error"
    },
    "cheer": {
      "intent": "celebrate",
      "description": "Celebracion"
    },
    "llorar": {
      "intent": "sad",
      "description": "Eyes Cry; escena de 4 segundos"
    },
    "drama": {
      "intent": "sad",
      "description": "Modo telenovela; alias de llorar"
    },
    "enojo": {
      "intent": "angry",
      "description": "Angry Sign; escena de 2.5 segundos"
    },
    "grrr": {
      "intent": "angry",
      "description": "Gruñido visual; alias de enojo"
    },
    "amor": {
      "intent": "celebrate",
      "description": "Heart Eyes; escena de 3 segundos"
    },
    "flechazo": {
      "intent": "celebrate",
      "description": "Cupido paso por aqui; alias de amor"
    },
    "susto": {
      "intent": "error",
      "description": "Shock Sign; escena de 2.5 segundos"
    },
    "buu": {
      "intent": "error",
      "description": "Susto de bolsillo; alias de susto"
    },
    "sacudida": {
      "intent": "shake",
      "description": "Activa Anim Shake; escena de 3 segundos"
    },
    "gelatina": {
      "intent": "shake",
      "description": "A temblar; alias de sacudida"
    },
    "reset": {
      "intent": "reset",
      "description": "Quita expresiones; respeta sleep y la duracion minima"
    }
  }
}
