{
  "$schema": "./schemas/rules.schema.json",
  "rules": [
    {
      "id": "errores-angry",
      "when": { "type": "error" },
      "intent": "angry",
      "priority": 20,
      "cooldownMs": 10000,
      "window": { "count": 2, "ms": 30000 }
    },
    {
      "id": "errores-sad",
      "when": { "type": "error" },
      "intent": "sad",
      "priority": 30,
      "cooldownMs": 30000,
      "window": { "count": 3, "ms": 120000 }
    },
    {
      "id": "error-inicial",
      "when": { "type": "error" },
      "intent": "error",
      "cooldownMs": 2500,
      "debounceMs": 500
    },
    {
      "id": "sesion-inicio",
      "when": { "type": ["session.start", "session.busy"], "state": { "asleep": false } },
      "intent": "thinking"
    },
    {
      "id": "pensando",
      "when": { "type": "reasoning" },
      "intent": "thinking"
    },
    {
      "id": "herramienta-codigo",
      "when": {
        "type": "tool.start",
        "tool": ["bash", "edit", "write", "patch", "apply_patch", "multiedit"]
      },
      "intent": "coding"
    },
    {
      "id": "herramienta-lectura",
      "when": {
        "type": "tool.start",
        "tool": ["read", "grep", "glob", "list", "search", "webfetch", "websearch", "codesearch", "lsp"]
      },
      "intent": "reading"
    },
    {
      "id": "respondiendo",
      "when": { "type": "response.start" },
      "intent": "answering"
    },
    {
      "id": "sesion-idle",
      "when": { "type": "session.idle" },
      "intent": "idle",
      "args": { "props": [] }
    }
  ]
}
