{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phrases.schema.json",
  "title": "phrases.json",
  "type": "object",
  "required": ["phrases"],
  "properties": {
    "settings": {
      "type": "object",
      "properties": {
        "minGapMs": { "type": "number", "minimum": 0 },
        "chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "memory": { "type": "integer", "minimum": 0 },
        "responseMaxChars": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "phrases": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/group" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "group": {
      "type": "object",
      "required": ["lines"],
      "properties": {
        "chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "ignoreGap": { "type": "boolean" },
        "description": { "type": "string" },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 280 }
        }
      },
      "additionalProperties": false
    }
  }
}
