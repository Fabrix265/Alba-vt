{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "rules.json",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringOrList": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "when": {
      "type": "object",
      "properties": {
        "type": { "$ref": "#/$defs/stringOrList" },
        "tool": { "$ref": "#/$defs/stringOrList" },
        "source": { "$ref": "#/$defs/stringOrList" },
        "ok": { "type": "boolean" },
        "textIncludes": { "type": "string" },
        "state": {
          "type": "object",
          "properties": {
            "asleep": { "type": "boolean" },
            "deepSleep": { "type": "boolean" },
            "effective": { "$ref": "#/$defs/stringOrList" },
            "base": { "$ref": "#/$defs/stringOrList" },
            "activity": { "anyOf": [{ "$ref": "#/$defs/stringOrList" }, { "type": "null" }] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "when", "intent"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "when": { "$ref": "#/$defs/when" },
        "intent": { "type": "string", "minLength": 1 },
        "priority": { "type": "number" },
        "cooldownMs": { "type": "number", "minimum": 0 },
        "debounceMs": { "type": "number", "minimum": 0 },
        "window": {
          "type": "object",
          "required": ["count", "ms"],
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "ms": { "type": "number", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "args": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
