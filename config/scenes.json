{
  "$schema": "./schemas/scenes.schema.json",
  "scenes": {
    "idle": {
      "layer": "base",
      "description": "Respira y mira al frente",
      "parameters": {
        "angleX": 0,
        "angleY": 0,
        "angleZ": 0,
        "smile": 0.15
      }
    },
    "thinking": {
      "layer": "activity",
      "parameters": {
        "angleX": 6,
        "angleY": 4,
        "angleZ": 3
      }
    },
    "coding": {
      "layer": "activity",
      "props": [
        "keyboard"
      ],
      "parameters": {
        "angleX": 0,
        "angleY": -8,
        "angleZ": 0
      }
    },
    "reading": {
      "layer": "activity",
      "parameters": {
        "angleX": -6,
        "angleY": -4,
        "angleZ": 0
      }
    },
    "celebrate": {
      "layer": "transient",
      "durationMs": 3000,
      "parameters": {
        "angleY": 5,
        "angleZ": 6,
        "smile": 0.85
      }
    },
    "error": {
      "layer": "transient",
      "durationMs": 2500,
      "parameters": {
        "angleY": -3,
        "angleZ": -5,
        "smile": 0
      }
    },
    "sad": {
      "layer": "transient",
      "durationMs": 4000,
      "parameters": {
        "angleY": -9,
        "angleZ": -4,
        "brow": 0.2,
        "smile": 0
      }
    },
    "angry": {
      "layer": "transient",
      "durationMs": 2500,
      "parameters": {
        "angleY": -2,
        "angleZ": 3,
        "brow": 0.1,
        "smile": 0
      }
    },
    "shake": {
      "layer": "transient",
      "durationMs": 3000,
      "description": "Sacudida; sin hotkey usa una pose inclinada",
      "parameters": {
        "angleX": -8,
        "angleZ": 12
      }
    },
    "reset": {
      "layer": "transient",
      "durationMs": 1200,
      "hotkey": "idle",
      "description": "Limpia expresiones y vuelve a la actividad anterior",
      "parameters": {
        "angleX": 0,
        "angleY": 0,
        "angleZ": 0,
        "smile": 0.15
      }
    },
    "sleep": {
      "layer": "base",
      "holdPoseWhileAsleep": true,
      "parameterRefreshMs": 500,
      "parameters": {
        "eyeOpen": 0,
        "eyeOpenRight": 0,
        "mouth": 0,
        "angleX": 12,
        "angleZ": -18
      }
    },
    "deep_sleep": {
      "layer": "base"
    },
    "wake": {
      "layer": "base"
    }
  }
}
